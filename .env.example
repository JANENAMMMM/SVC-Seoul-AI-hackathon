# Supabase 프로젝트 URL과 서버 전용 Secret key를 입력하세요.
# Secret key는 프론트엔드에 전달하지 마세요.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Connect > Session pooler의 URI. [YOUR-PASSWORD]를 DB 비밀번호로 교체하세요.
SUPABASE_DB_URL=

# Google Places API (New) 키. 식당 수집(src/restaurants)에서 사용합니다.
GOOGLE_API_KEY=

# Claude API 키. 식당 한식 판단(src/restaurants/korean_check.py, 선택 기능)에서 사용합니다.
ANTHROPIC_API_KEY=
