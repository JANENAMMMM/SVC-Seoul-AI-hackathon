{
  "_meta": {
    "version": "0.3-draft",
    "created": "2026-11-04",
    "purpose": "일정 엔진용 관광지별 내부 보행·체류 기준 데이터",
    "rules": [
      "값은 재은님 수집 데이터(GPS 실측, 사실 데이터)에서만 가져왔다. 목업(fixtures.js) 값은 임의 가정이라 쓰지 않았다.",
      "null은 아직 값이 없다는 뜻이다. 엔진이 임의로 채우지 않고 assumptions[]에 가정값으로 표시해야 한다.",
      "walk_m·walk_min은 걷는 거리·시간이다(GPS·사실 데이터). 체류 시간은 stay_level 3단계로만 표시한다.",
      "region은 좌표를 보고 묶은 값이다.",
      "scores는 재은님 visit_modes_v2_1.json의 방식별(standard/short/full) 종합·보행량·오르막 점수(1~10)이다. 보행 부담 판단에 쓴다.",
      "stay_level은 brief/half/long 3단계다(분 환산은 stay_config.json). 재은님 modes의 'short'(관람 방식)와 혼동하지 않도록 이름을 달리했다.",
      "stay_source가 manual_*이면 그 값을 그대로 쓰고, 값이 없거나 새 관광지면 types 기준 기본값(stay_config.json)으로 계산한다 (src/planner/stay.py).",
      "manual_estimate 값은 일반 관광 소요시간 기준 추정이라 신뢰도가 낮다. 팀 검수 전까지 assumptions에 노출한다."
    ],
    "confidence_levels": {
      "high": "GPS 궤적 10개 이상 또는 복수 출처",
      "medium": "사실 데이터 1건 또는 GPS 표본 5개 내외",
      "low": "GPS 표본 3개 이하",
      "none": "값 없음, 조사 필요"
    },
    "sources": {
      "gps": "data/scoring/derived/gps_traces.json (OSM 공개 GPS 궤적, summary 중앙값)",
      "fact": "data/scoring/derived/site_facts.json (초기 웹조사 사실 데이터)",
      "types": "data/scoring/attractions.json의 google.type (일부 부정확: 구시가지 없음, 야시장 'Tour operator')"
    }
  },
